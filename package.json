{
  "name": "tv-shows-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#server/*": "./server/*",
    "#shared": "./shared/index.ts"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm run --stream \"/^dev:/\"",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env  server/main.ts",
    "start": "node server/main.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:arch": "node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm check:arch && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.108.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
